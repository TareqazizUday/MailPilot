.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.pyd
*.pyo
*.pdb
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtualenv
.venv/
venv/
ENV/
env/

# Django static/media build outputs
staticfiles/
media/

# Local data / tokens / creds (never commit)
# Django DB is PostgreSQL via DJANGO_DB_*; ignore stray local SQLite files
data/django.sqlite3
data/*.sqlite3
data/state.db
*.sqlite3-wal
*.sqlite3-shm

# Env files with secrets (keep only *.example templates in git)
.env
.env.local
.env.production
.env.development
.env.staging
.env.*.local
.env.*
*.env
!.env.example
!.env.production.example

# OAuth / API credential files
client_secret*.json
client_secret*.json.*
client_secret*.bak
*.deleted_client.bak
*credentials*.json
!*credentials*.example.json
service-account*.json
*.pem
*.p12
*.key
!*.key.example

# Runtime tokens / per-user mailbox data
data/**/client_secret*.json
data/**/token*.json
data/users/**
data/crawl_test/

# Scraper CLI test output (regenerated by python -m scraper.test_crawl)
scraper/output/*
!scraper/output/.gitignore

# Local tooling
.idea/
.vscode/

# Cursor IDE / local DB dumps (not application source)
.cursor/
mailpilot_dump.sql
mailpilot_backup.sql
backups/
*.dump
