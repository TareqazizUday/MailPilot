# PRODUCTION template for https://mailpilots.net
# Copy to `.env` on the server (same folder as manage.py) and fill every <...> value.
# Never commit the real .env. Guide: docs/PRODUCTION_DEPLOY.md
#
# IMPORTANT when updating an existing server: keep its current DJANGO_SECRET_KEY,
# FIELD_ENCRYPTION_KEY and DJANGO_DB_* values. A new FIELD_ENCRYPTION_KEY makes saved
# mailbox passwords/API keys unreadable; a new SECRET_KEY logs everyone out.

# ---- Environment ----
# production = DEBUG off, HTTPS redirect, secure cookies, hosts from SITE_URL.
# The app refuses to start if SITE_URL or DJANGO_SECRET_KEY is missing.
MAILPILOT_ENV=production
SITE_URL=https://mailpilots.net
# Optional extra hosts; mailpilots.net, www.mailpilots.net, 127.0.0.1 and localhost are added automatically.
DJANGO_ALLOWED_HOSTS=
# Optional extra CSRF origins; SITE_URL (+ www) is added automatically.
# DJANGO_CSRF_TRUSTED_ORIGINS=

# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=<keep-existing-or-generate>
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=<keep-existing-or-generate>

# ---- Reverse proxy (nginx / IIS terminates HTTPS) ----
# The proxy must send X-Forwarded-Proto and Host (see docs). If it cannot send
# X-Forwarded-Proto, set DJANGO_BEHIND_HTTPS_PROXY=true so the app assumes HTTPS.
DJANGO_BEHIND_HTTPS_PROXY=false
# Defaults on production: SSL redirect on, secure cookies on, X-Forwarded-Host trusted.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_COOKIE_SECURE=true
# DJANGO_USE_X_FORWARDED_HOST=true
# nginx already sends HSTS for mailpilots.net; set these only if it stops doing so.
DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true

# ---- Database (PostgreSQL + pgvector) ----
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=mailpilot
DJANGO_DB_USER=mailpilot_user
DJANGO_DB_PASSWORD=<db-password>
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
VECTOR_DB_DSN=

# ---- Outbound email (password reset, contact form) ----
CONTACT_TEAM_EMAIL=team@timerni.co.uk
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-user>
SMTP_PASSWORD=<smtp-password>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_VERIFY_TLS=true
SMTP_TLS_SERVERNAME=
SMTP_FROM_EMAIL=<noreply@mailpilots.net>

# ---- Gmail connect (Google Cloud OAuth client, "Authorized redirect URIs") ----
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
GOOGLE_TOKEN_FILE=data/token.json
OAUTH_REDIRECT_URI=https://mailpilots.net/api/gmail/oauth/callback

# ---- Sign in with Google / GitHub (Firebase project mailpilot-f4add) ----
# Firebase -> Authentication -> Settings -> Authorized domains must list mailpilots.net and www.mailpilots.net.
FIREBASE_PROJECT_ID=mailpilot-f4add
FIREBASE_API_KEY=<firebase-web-api-key>
FIREBASE_AUTH_DOMAIN=mailpilot-f4add.firebaseapp.com
FIREBASE_APP_ID=<firebase-web-app-id>
# Redirect fallback for Google when Firebase is off. Redirect URI: https://mailpilots.net/auth/social/google/callback
GOOGLE_LOGIN_CLIENT_ID=<google-oauth-client-id>
GOOGLE_LOGIN_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_LOGIN_MOBILE_CLIENT_IDS=

# ---- AI ----
LLM_PROVIDER=openai
OPENAI_API_KEY=<openai-key>
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Mail automation defaults ----
IMAP_POLL_SECONDS=60
IMAP_IDLE_ENABLED=true
GMAIL_QUERY_LABELS=INBOX
REPLY_MODE=send
SEND_TRANSPORT=gmail_api

# ---- Billing (live) ----
BILLING_DEMO_MODE=false
STRIPE_KEY_ENVIRONMENT=auto
STRIPE_LIVE_SECRET_KEY=<sk_live_...>
STRIPE_LIVE_PUBLISHABLE_KEY=<pk_live_...>
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Stripe Dashboard -> Webhooks -> https://mailpilots.net/billing/webhook/stripe
STRIPE_WEBHOOK_SECRET=<whsec_...>
PAYPAL_ENVIRONMENT=auto
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_PLAN_PRO_MONTHLY=
PAYPAL_WEBHOOK_ID=

# ---- Notifications ----
EXPO_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ---- Background jobs ----
# Empty = in-process scheduler inside the web server (one server process only).
# With Redis: set this and run `celery -A mailpilot worker` + `celery -A mailpilot beat`.
CELERY_BROKER_URL=
